NODE_ENV=development
PORT=8000

# HS256 signing secret for authority sessions (≥32 random characters in production).
AUTH_SECRET=replace-with-a-long-random-secret
# Authority accounts: JSON array produced by `node scripts/hash-password.js <user> <role>`.
AUTHORITY_USERS=[]

# Browser origins allowed to call the API (comma separated, no wildcards).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Firebase Admin credentials for FCM — use exactly ONE of these. Backend only.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Regional monitoring refresh cadence (Open-Meteo counts every location as a call).
MONITORING_REFRESH_MINUTES=60
MODEL_RUNTIME=portable
PYTHON_BIN=python
RATE_LIMIT_PER_MINUTE=180

