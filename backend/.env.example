# Google & Firebase Configuration
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PROJECT_NUMBER=your-project-number
GOOGLE_STORAGE_BUCKET=your-storage-bucket.appspot.com
GOOGLE_APP_ID=your-mobilesdk-app-id

NODE_ENV=development
PORT=8000
# Required in production. Use a high-entropy random value.
AUTH_SECRET=replace-with-a-long-random-secret
# Comma-separated dashboard origins; never use * in production.
CORS_ORIGINS=http://localhost:5173
MODEL_RUNTIME=portable
PYTHON_BIN=python
RATE_LIMIT_PER_MINUTE=180

