# LandGuard production configuration. Copy to deploy/.env.production and fill in.
# Never commit the filled-in file — it holds secrets.

# ── Domains & TLS ─────────────────────────────────────────────
LANDGUARD_WEB_DOMAIN=landguard.online
LANDGUARD_API_DOMAIN=api.landguard.online
ACME_EMAIL=you@example.com

# ── API ───────────────────────────────────────────────────────
# Only the authority web may call the API from a browser.
CORS_ORIGINS=https://landguard.online,https://www.landguard.online
# ≥32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# JSON array of authority accounts, one entry per line of:
#   docker compose -f deploy/docker-compose.prod.yml run --rm api node backend/scripts/hash-password.js <username> <operator|incident_commander|admin> "Display Name"
AUTHORITY_USERS=[]

# ── Firebase Cloud Messaging (backend only) ───────────────────
# base64 of the Firebase Admin service-account JSON for project landguard-a4620:
#   base64 -w0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Monitoring ────────────────────────────────────────────────
MONITORING_REFRESH_MINUTES=60
RATE_LIMIT_PER_MINUTE=180
